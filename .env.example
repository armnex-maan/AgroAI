# --- Database ---
POSTGRES_USER=agroai
POSTGRES_PASSWORD=agroai_dev
POSTGRES_DB=agroai
DATABASE_URL=postgresql+psycopg://agroai:agroai_dev@db:5432/agroai

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET=change-me-in-production
DEVICE_HMAC_SECRET=device-shared-secret-change-me
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Simulation ---
SIMULATION_ENABLED=true
SIMULATION_INTERVAL_SECONDS=10
SIMULATION_DEFAULT_SCENARIO=healthy

# --- AI / LLM (optional, pluggable) ---
AI_PROVIDER=none   # none | anthropic | ollama | nvidia
AI_LANGUAGE=Italian
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
ANTHROPIC_API_KEY=
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1

# --- External integrations ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
BIRDNET_ENABLED=false

# --- MQTT (future, Phase 4) ---
MQTT_BROKER_HOST=mqtt
MQTT_BROKER_PORT=1883
